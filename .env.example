# Firebase Configuration (Default Cloud Database)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Application Security & Access Passwords
SITE_PASSWORD="your-master-admin-password"
GUESS_PASSWORD="your-guest-client-password"

# Redis Cache (Primary & Backup Failover Connection Strings)
REDIS_URL="rediss://default:password@primary-redis-hostname:6379"
REDIS_URL_2="rediss://default:password@backup-redis-hostname:6379"

# Database Provider Configuration (Default: "firebase", atau "postgres" jika menggunakan PostgreSQL / Supabase)
NEXT_PUBLIC_DB_PROVIDER="firebase"

# PostgreSQL / Supabase Universal Connection String (Hanya diisi jika menggunakan PostgreSQL)
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=""

# Vercel API Integration (Untuk fitur 1-klik "Push ke Vercel & Auto-Deploy" dari menu Settings)
# Buat token di: https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN="your-vercel-personal-access-token"
# Lihat Project ID di: Vercel Dashboard > Project > Settings > General > Project ID (diawali prj_...)
VERCEL_PROJECT_ID="your-vercel-project-id"
# Opsional jika project berada di bawah Team Vercel
VERCEL_TEAM_ID=""
